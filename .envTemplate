# EuroEdge Admission Group — Environment Template
# Copy this file to .env to get started: cp .envTemplate .env
# IMPORTANT: Do NOT wrap values in quotes when using Node --env-file.

LOCAL_STORAGE_KEY=local-dev-storage-key
SESSION_SECRET=local-dev-session-secret
NODE_ENV=development
PORT=3000

# Hidden Admin CMS Credentials (template default: test / test)
# Generate custom production values with:
